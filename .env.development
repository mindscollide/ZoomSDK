# Diskus origins allowed to control this iframe via postMessage (comma-separated,
# no trailing slash). Must match the origin of the page embedding the iframe.
REACT_APP_PARENT_ORIGINS=http://localhost:5173,http://localhost:3000,http://192.168.18.243

# Video SDK JWT endpoint. The dev server (localhost:5500) is not on the API's
# origin, so point at the local Diskus video API explicitly.
REACT_APP_AUTH_ENDPOINT=http://192.168.18.243:11022/api/Video/GenerateVideoSdkJwt
