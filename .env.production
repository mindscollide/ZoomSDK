# Diskus origins allowed to control this iframe via postMessage (comma-separated,
# no trailing slash). Must match the origin of the page embedding the iframe.
# One list for every deployment, so the same build works on each environment:
#   portal.letsdiskus.com   -> staging (Diskus .env.staging)
#   secure.letsdiskus.com   -> UAT (Diskus .env.uat)
#   secure.diskusboard.com  -> production (Diskus .env.production)
#   optimized.letsdiskus.com -> optimized (Diskus .env.optimized; embeds the portal build)
REACT_APP_PARENT_ORIGINS=https://portal.letsdiskus.com,https://secure.letsdiskus.com,https://secure.diskusboard.com,https://optimized.letsdiskus.com

# REACT_APP_AUTH_ENDPOINT is intentionally unset: the app then calls
# <its own origin>/api/Video/GenerateVideoSdkJwt, which is the right API on
# every deployment (portal/secure/diskusboard :9414). Set it only if the app is
# ever hosted on a different origin from the video API.
